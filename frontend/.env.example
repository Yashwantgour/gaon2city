# Gaon2City Frontend Environment Variables Template
# Copy this file to .env or .env.local and populate with your credentials

# Supabase Public Keys
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Mapbox Public Access Token (for maps & client-side turn-by-turn navigation)
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Backend API Base URL (Deployed Render URL or local development server)
VITE_API_BASE_URL=https://gaon2city.onrender.com/api
