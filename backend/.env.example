# Gaon2City Backend Environment Variables Template
# Copy this file to .env and populate with your credentials

# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:5173

# Supabase Server-Side Configuration (Keep service role key private!)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mapbox Server Proxy Token
MAPBOX_TOKEN=pk.your_mapbox_token

# Razorpay Payments Integration (Test or Live keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key
